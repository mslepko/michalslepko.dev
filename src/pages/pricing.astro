---
import { Image } from "astro:assets"
import Layout from "../components/layout/Layout.astro"
import UsesLine from "../components/UsesLine.astro"
import njaOverview from "../images/stats/nja_overview.png"
import igOverview from "../images/stats/ig_overview.jpg"
---

<Layout title="Partnerships pricing" robots="nofollow, noindex">
  <div class="container mx-auto p-8 pb-16 text-center max-w-screen-xl">
    <h1 class="text-2xl sm:text-3xl font-bold text-darkest dark:text-lightest tracking-tight pt-10 text-center pb-16">
      Pricing
    </h1>
    <div class="pt-14">
      <p class="text-darkest dark:text-lightest pb-1 text-xl">
        If you found this page it means you want to collaborate with me!
      </p>
      <p class="text-darkest dark:text-lightest pb-1 text-xl">
        This page contains information about me, links to my previous
        partnerships, my stats and my pricing.
      </p>
      <p class="text-darkest dark:text-lightest pb-1 text-xl">
        If you are interested or have questions please email me at{" "}
        <a
          href="mailto:michal@rootscope.co.uk"
          class="text-brand hover:text-darkest dark:text-brand dark:hover:text-white"
        >
          michal@rootscope.co.uk
        </a>
      </p>
    </div>

    <h3 class="text-center text-xl sm:text-1xl font-bold text-darkest dark:text-lightest tracking-tight pt-14">
      About me
    </h3>
    <p class="text-darkest dark:text-lightest text-left pb-1 text-xl">
      My name is Michal Slepko, I'm a software engineer based in the UK. I'm
      creating content related to my day-to-day job as a developer. <br />I post
      mainly about software development, productivity, working from home and
      having fun while doing what you love.
    </p>
    <p class="text-darkest dark:text-lightest pb-1 text-xl text-left">
      I create content on Instagram and then repurpose it to TikTok and YouTube.
      I'm also streaming on Twitch where you can find me coding or just
      co-working with others.
    </p>

    <div class="flex flex-col md:flex-row gap-10">
      <div class="flex-1">
        <h3 class="text-center text-xl sm:text-1xl font-bold text-darkest dark:text-lightest tracking-tight pt-14">
          Social Media links
        </h3>
        <UsesLine type="socials" addClasses="w-full md:w-full" />
      </div>
      <div>
        <h3 class="text-center text-xl sm:text-1xl font-bold text-darkest dark:text-lightest tracking-tight pt-14">
          Pricing
        </h3>
        <ul class="pricing text-darkest bg-white rounded-lg shadow-md md:flex-row max-w-xl m-auto mt-8">
          <li class="py-2 px-4 w-full rounded-t-lg border-b border-gray-200 transition-all duration-500 hover:bg-mint">
            <p class="font-bold">Link in bio - 50 USD/month</p>
            <p class="text-left">Link in my bio to your brand/product.</p>
          </li>
          <li class="py-2 px-4 w-full rounded-t-lg border-b border-gray-200 transition-all duration-500 hover:bg-mint">
            <p class="font-bold">1 story - 99 USD</p>
            <p class="text-left">
              A dedicated Instagram story about you or your brand/product
              including a link and your profile mention.
            </p>
          </li>
          <li class="py-2 px-4 w-full rounded-t-lg border-b border-gray-200 transition-all duration-500 hover:bg-mint">
            <p class="font-bold">1 post (+ announcing story) - 299 USD</p>
            <p class="text-left">
              A dedicated Instagram post about you or your brand, with a story
              that promotes it with a link and your profile mention.
            </p>
          </li>
          <li class="py-2 px-4 w-full rounded-t-lg border-b border-gray-200 transition-all duration-500 hover:bg-mint">
            <p class="font-bold">1 reel (+ announcing story) - 399 USD</p>
            <p class="text-left">
              A dedicated Instagram reel about you or your brand, with a story
              that promotes it with a link and your profile mention.
            </p>
          </li>
          <li class="py-2 px-4 w-full rounded-t-lg border-b border-gray-200 transition-all duration-500 hover:bg-mint">
            <p class="font-bold">Long-term sponsorship - 4 weeks - 1200 USD</p>
            <p class="text-left">
              {" "}
              - Includes 2 dedicated post and 2 dedicated Reels about your
              brand/product.
            </p>
            <p class="text-left">
              {" "}
              - Other posts (minimum 2) and reels (minimum 2) related to my
              normal content will have your product/brand mentioned in the
              caption.
            </p>
            <p class="text-left">
              {" "}
              - A link to a dedicated page for your brand/product in my bio for
              the entire duration.
            </p>
            <p class="text-left">
              {" "}
              - Stories (minimum 2/week) promoting the post/reel will include a
              brand/product shoutout.
            </p>
          </li>
        </ul>
        <p class="text-base text-darkest dark:text-lightest">
          *All Reels are posted on TikTok and YT Shorts.
        </p>
      </div>
    </div>
    <h3 class="text-center text-xl sm:text-1xl font-bold text-darkest dark:text-lightest tracking-tight pt-14">
      Social Media stats
    </h3>
    <Image
      src={njaOverview}
      alt="NotJustAnalytics stats overview"
      widths={[640, 1280, 1721]}
      sizes="(min-width: 1280px) 1216px, 100vw"
      class="block mx-auto mb-8 w-full"
    />
    <Image
      src={igOverview}
      alt="Instagram stats overview"
      widths={[640, 1280, 2309]}
      sizes="(min-width: 1280px) 1216px, 100vw"
      class="block mx-auto w-full"
    />

    <p class="text-darkest dark:text-lightest pb-1 text-xl mt-8">
      If you are interested or have questions please email me at{" "}
      <a href="mailto:michal@rootscope.co.uk" class="text-light-blue">
        michal@rootscope.co.uk
      </a>
    </p>
  </div>
</Layout>
