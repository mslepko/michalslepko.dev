---
import Layout from "../../components/layout/Layout.astro"
import PostListLayout from "../../components/PostListLayout.astro"
import { getSortedSnippets } from "../../lib/snippets"

export async function getStaticPaths({ paginate }) {
  const snippets = await getSortedSnippets()
  return paginate(snippets, { pageSize: 12 })
}

const { page } = Astro.props
---

<Layout title="My Snippets">
  <div class="container mx-auto p-8 pb-16">
    <h1 class="text-center text-2xl sm:text-3xl font-bold text-darkest dark:text-lightest tracking-tight pt-10">
      My Snippets
    </h1>
    <PostListLayout
      posts={page.data}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
    />
  </div>
</Layout>
