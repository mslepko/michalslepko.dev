---
import Instagram from "../../../images/svgs/instagram-icon.svg"
import Twitter from "../../../images/svgs/twitter-icon.svg"
import Github from "../../../images/svgs/github-icon.svg"
import LinkedIn from "../../../images/svgs/linkedin.svg"
---

<div>
  <ul class="flex flex-col md:flex-row items-end md:items-center md:space-x-4 space-y-4 md:space-y-0">
    <li>
      <a
        href="https://www.instagram.com/michal.codes/"
        target="_blank"
        aria-label="Instagram"
        class="hover:text-blue-600 socials"
        rel="noopener noreferrer"
      >
        <Instagram />
      </a>
    </li>
    <li>
      <a
        href="https://twitter.com/michal_codes"
        target="_blank"
        aria-label="Twitter"
        class="hover:text-blue-600 socials"
        rel="noopener noreferrer"
      >
        <Twitter />
      </a>
    </li>
    <li>
      <a
        href="https://www.github.com/mslepko"
        target="_blank"
        aria-label="Github"
        class="hover:text-blue-600 socials"
        rel="noopener noreferrer"
      >
        <Github />
      </a>
    </li>

    <li>
      <a
        href="https://www.linkedin.com"
        target="_blank"
        aria-label="linkedin"
        class="hover:text-blue-600 socials"
        rel="noopener noreferrer"
      >
        <LinkedIn />
      </a>
    </li>
  </ul>
</div>
